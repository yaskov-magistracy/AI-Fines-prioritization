# Скопировать в .env и заполнить. .env в git не попадает.
APP_ENV=local
LOG_LEVEL=INFO

# Postgres
DATABASE_URL=postgresql+asyncpg://fines:fines@localhost:5432/fines

# Где лежат исходные PDF и извлечённые фото
STORAGE_DIR=./storage

# Экстрактор: rule_based | llm
EXTRACTOR_BACKEND=rule_based

# Провайдер цен: stub | http
PRICE_PROVIDER=stub
PRICE_API_BASE_URL=
PRICE_API_KEY=

# LLM-бэкенд экстрактора (нужен только при EXTRACTOR_BACKEND=llm)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
